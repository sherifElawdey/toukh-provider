<?xml version="1.0" encoding="utf-8"?>
<!-- Saved settings include Firebase Auth's encrypted session, which is useless
     (and blocks signing in again) without the Keystore key that is never
     backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
